    "name": "UPDATED Battery Powered Flashlight",
    "description": "A fantastic product for outdoor enthusiasts",
    "price": 19.99,
    "imageUrl": "product10.png"
}

DELETE {{Catalog_HostAddress}}/products/10
Content-Type: application/json

